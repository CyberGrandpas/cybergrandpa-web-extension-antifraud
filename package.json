{
  "name": "cybergrandpa-cross-browser-extension-antifraud",
  "description": "A browser web extension for safety and anti-fraud online activities.",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ./src",
    "lint": "prettier --check ./src && eslint ./src"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@thedutchcoder/postcss-rem-to-px": "^0.0.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "0.1.42",
    "@types/lokijs": "^1.5.14",
    "@typescript-eslint/parser": "^8.59.2",
    "@webext-core/proxy-service": "^1.2.1",
    "@wxt-dev/i18n": "^0.2.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "autoprefixer": "^10.5.0",
    "change-case": "^5.4.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.3",
    "lokijs": "^1.5.12",
    "nanoid": "^5.1.11",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-loading-spinners": "^0.3.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "webext-base-css": "^2.1.0",
    "wxt": "^0.20.25"
  }
}
